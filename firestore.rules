rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Users / Ambassador Profiles Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // FCM Tokens Collection
    match /fcmTokens/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Referrals / Leads Collection
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (resource.data.ambassadorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated(); // Registered via client/server onboarding
      allow update, delete: if isAdmin(); // Only admin can modify referral status/qualification
    }

    // Earnings Collection
    match /earnings/{earningId} {
      allow read: if isAuthenticated() && (resource.data.ambassadorId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin(); // Earnings ledger managed server-side
    }

    // Payouts Collection
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (resource.data.ambassadorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ambassadorId == request.auth.uid; // Ambassador requests payout
      allow update, delete: if isAdmin(); // Admin approves/processes payouts
    }

    // Marketing Resources Collection
    match /resources/{resourceId} {
      allow read: if isAuthenticated(); // All authenticated ambassadors can view resources
      allow create, update, delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Email Verifications Collection
    match /emailVerifications/{verificationId} {
      allow read, write: if true;
    }
  }
}
