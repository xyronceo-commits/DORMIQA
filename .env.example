# GEMINI_API_KEY / DORMIQA_API_KEY: Required for Gemini & Custom AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
DORMIQA_API_KEY="your_dormiqa_api_key"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI / OPENROUTER / LLM API KEY
# Used for AI search recommendations (openai/gpt-oss-120b) and Dormiqa AI Chatbot (qwen/qwen3.6-27b)
# Configure via the Secrets tab in AI Studio
LLM_API_KEY="your_llm_or_openrouter_api_key"

# Optional LLM Base URL (Defaults to https://openrouter.ai/api/v1)
LLM_BASE_URL="https://openrouter.ai/api/v1"

# LLM Models for Search and Chat
LLM_SEARCH_MODEL="openai/gpt-oss-120b"
LLM_CHAT_MODEL="qwen/qwen3.6-27b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Supabase or external database
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# SUPABASE Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# GOOGLE MAPS API KEY (Optional for client-side map tiles or places autocomplete)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# JWT Secret for Auth Sessions
JWT_SECRET="dormiqa_super_secret_jwt_key_2026"

# Secure Admin Access Password
ADMIN_PASSWORD="Dormiqa_ambassador_9900234"

